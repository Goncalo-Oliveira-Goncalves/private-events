<% content_for :title, "Sign Up - Eventu" %>

<div class="signup main-container">
  <%= form_with url: login_path, class: "signup form" do |f| %>
    <div class="field">
      <%= f.label :email %><br />
      <%= f.email_field :email %>
    </div>
    <div class="field">
      <%= f.label :password %><br />
      <%= f.password_field :password %>
    </div>
    <div class="signup actions"><%= f.submit "Sign In", class: "submit-button" %></div>
  <% end %>
</div>